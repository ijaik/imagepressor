{
  "name": "imagepressor",
  "version": "0.2.0",
  "description": "High-performance, zero-dependency, client-side image compression library that runs off the main thread in a Web Worker, preserving camera EXIF metadata and Display P3 color profiles.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test"
  },
  "keywords": [
    "imagepressor",
    "image-compressor",
    "image-compression",
    "browser-image-compression",
    "client-side",
    "web-worker",
    "offscreen-canvas",
    "exif",
    "icc-profile",
    "display-p3",
    "zero-dependency",
    "bun"
  ],
  "author": {
    "name": "Jai",
    "url": "https://github.com/ijaik"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ijaik/imagepressor.git"
  },
  "homepage": "https://github.com/ijaik/imagepressor#readme",
  "bugs": {
    "url": "https://github.com/ijaik/imagepressor/issues"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  }
}
